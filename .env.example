# Database Configuration
# For development: use your local database
# For testing: set TEST_DATABASE_URL to a dedicated test database
DATABASE_URL=postgresql://user:password@localhost:5432/homeops
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/homeops_test

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-here

# Cookie Security
# Set to true in production for HTTPS environments
SECURE_COOKIES=false
